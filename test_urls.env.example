# test_urls.env.example — template for run_realworld_tests.sh
#
# Copy to `test_urls.env` (gitignored) and fill in your own URLs:
#
#     cp test_urls.env.example test_urls.env
#     chmod 600 test_urls.env
#
# NEVER commit `test_urls.env`: it holds URLs tied to your account and, if you
# enable the free-account pass, an ARL — a Deezer session token equivalent to a
# password.
#
# Any variable left empty marks its case as SKIP, so the script is usable with
# only some of these lines filled in.

# ── Base cases ───────────────────────────────────────────────────────────────
# An encrypted track: exercises Blowfish stream decryption. Also the default for
# CONVERT_URL (conversion + re-tag) and REPAIR_TRACK_URL (rip repair).
TRACK_URL="https://www.deezer.com/us/track/0000000"

# Several tracks in a single `rip url` invocation: takes the PendingSingle path,
# distinct from the PendingTrack path used by albums.
TRACK_URLS="https://www.deezer.com/us/track/0000000 https://www.deezer.com/us/track/0000001"

# An album: batched GW prefetch + the _album_cache.
ALBUM_URL="https://www.deezer.com/us/album/0000000"

# A playlist: fetched through the GW API (gw.get_playlist), specific to this fork.
PLAYLIST_URL="https://www.deezer.com/us/playlist/0000000"

# Your loved tracks: `favorites:<uid>` routing + GW pagination. The uid is YOUR
# account's — this URL is readable by that account only (see FREE_LOVED_URL).
LOVED_URL="https://www.deezer.com/us/profile/000000000/loved"

# An artist's top tracks: get_artist_top_tracks.
ARTIST_TOP_URL="https://www.deezer.com/us/artist/0000000/top_track"

# A Last.fm playlist: the paginated parsers.
LASTFM_URL="https://www.last.fm/user/<username>/loved"

# ── Free-account pass (optional) ─────────────────────────────────────────────
# The ARL of a Deezer account WITHOUT a HiFi licence. When set, it triggers a
# second pass replaying every case with FLAC forced: the WrongLicense loop must
# downgrade to MP3. This is the only real-data coverage of the fork's main
# divergence from upstream.
#
# An ARL is a secret. The script neither prints nor writes one, but this file
# does hold it: keep it at mode 0600 and out of git.
FREE_ARL=""

# Loved tracks are account-scoped, so replaying LOVED_URL with the free ARL
# queries a profile that account may not read — Deezer then returns an empty
# list without an error. Set the free account's own profile here (and add some
# favourites to it); otherwise the case is skipped in that pass.
#FREE_LOVED_URL="https://www.deezer.com/us/profile/000000000/loved"
